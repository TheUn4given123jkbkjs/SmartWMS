flowchart LR
    classDef base fill:#90caf9,stroke:#1565c0,stroke-width:2px,color:#000000,font-weight:bold;
    classDef ext fill:#e3f2fd,stroke:#1976d2,stroke-width:1.8px,stroke-dasharray:4 3,color:#1565c0,font-weight:bold;
    classDef actor fill:#ffffff,stroke:#333333,stroke-width:2px,color:#111111,font-weight:bold;

    subgraph SYSTEM ["SmartWMS - Sơ đồ chi tiết UC02: Lập phiếu nhập kho"]
        direction LR
        subgraph COL_A [" "]
            direction TB
            UC02(["Lập phiếu nhập kho"]):::base
        end
        subgraph COL_B [" "]
            direction TB
            UC_PO(["Tra cứu Đơn mua hàng PO"]):::base
            UC_PUTAWAY(["Chỉ định vị trí ô kệ cất hàng"]):::base
            UC_REJECT(["Từ chối nhận hàng lỗi"]):::ext
        end
    end

    style COL_A fill:none,stroke:none;
    style COL_B fill:none,stroke:none;

    Actor_Maker["Nhân viên kho<br>Maker"]:::actor
    Actor_Maker --- UC02

    UC02 -. "<<include>>" .-> UC_PO
    UC02 -. "<<include>>" .-> UC_PUTAWAY
    UC_REJECT -. "<<extend>>" .-> UC02
