flowchart LR
    classDef base fill:#90caf9,stroke:#1565c0,stroke-width:2px,color:#000000,font-weight:bold;
    classDef ext fill:#e3f2fd,stroke:#1976d2,stroke-width:1.8px,stroke-dasharray:4 3,color:#1565c0,font-weight:bold;
    classDef actor fill:#ffffff,stroke:#333333,stroke-width:2px,color:#111111,font-weight:bold;

    subgraph SYSTEM ["SmartWMS - Sơ đồ chi tiết UC04: Lập phiếu xuất kho"]
        direction LR
        subgraph COL_A [" "]
            direction TB
            UC04(["Lập phiếu xuất kho"]):::base
        end
        subgraph COL_B [" "]
            direction TB
            UC_AVAIL(["Kiểm tra tồn khả dụng"]):::base
            UC_FEFO(["Gợi ý lô FEFO và FIFO"]):::base
            UC_RESERVE(["Tạm giữ chỗ tồn kho"]):::base
        end
        subgraph COL_C [" "]
            direction TB
            SPACER[" "]:::ext
            UC_OVERRIDE(["Giải trình xuất ngoại lệ"]):::ext
        end
    end

    style COL_A fill:none,stroke:none;
    style COL_B fill:none,stroke:none;
    style COL_C fill:none,stroke:none;
    style SPACER fill:none,stroke:none,color:transparent;

    Actor_Maker["Nhân viên kho<br>Maker"]:::actor
    Actor_Maker --- UC04

    UC04 -. "<<include>>" .-> UC_AVAIL
    UC04 -. "<<include>>" .-> UC_FEFO
    UC04 -. "<<include>>" .-> UC_RESERVE
    UC_OVERRIDE -. "<<extend>>" .-> UC_FEFO
