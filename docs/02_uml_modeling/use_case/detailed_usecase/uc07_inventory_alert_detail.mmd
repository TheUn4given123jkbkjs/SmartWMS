flowchart LR
    classDef base fill:#90caf9,stroke:#1565c0,stroke-width:2px,color:#000000,font-weight:bold;
    classDef ext fill:#e3f2fd,stroke:#1976d2,stroke-width:1.8px,stroke-dasharray:4 3,color:#1565c0,font-weight:bold;
    classDef actor fill:#ffffff,stroke:#333333,stroke-width:2px,color:#111111,font-weight:bold;

    subgraph SYSTEM ["SmartWMS - Sơ đồ chi tiết UC07: Xem cảnh báo tồn kho"]
        direction LR
        subgraph COL_A [" "]
            direction TB
            UC07_VIEW(["Xem bảng cảnh báo tồn kho"]):::base
            UC07_AUTO(["Tự động quét kho định kỳ"]):::base
        end
        subgraph COL_B [" "]
            direction TB
            UC_REORDER(["Đề xuất số lượng đặt mua"]):::ext
            UC_MIN(["Quét tồn dưới mức tối thiểu"]):::base
            UC_EXP(["Quét lô cận hạn 30 ngày"]):::base
        end
    end

    style COL_A fill:none,stroke:none;
    style COL_B fill:none,stroke:none;

    Actor_Purchaser["Nhân viên Mua hàng"]:::actor
    Actor_Scheduler["Bộ định thời<br>Scheduler 00:00:00"]:::actor

    Actor_Purchaser --- UC07_VIEW
    Actor_Scheduler --- UC07_AUTO

    UC_REORDER -. "<<extend>>" .-> UC07_VIEW
    UC07_VIEW -. "<<include>>" .-> UC_MIN
    UC07_VIEW -. "<<include>>" .-> UC_EXP
    UC07_AUTO -. "<<include>>" .-> UC_EXP
